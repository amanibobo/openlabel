{
  "name": "openlabel-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @openlabel/web",
    "build": "npm run build -w @openlabel/web",
    "test": "vitest run --dir packages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docs": "cd apps/docs && npx mint dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
